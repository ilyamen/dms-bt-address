#!/usr/bin/python3 -I
"""Keep a custom public address on Bluetooth controllers.

Some controllers (MediaTek MT79xx among them) reload their firmware on every
power-on and come back with the factory address, while the kernel programs an
address set with MGMT Set Public Address only once, right after it is set. The
daemon listens on the mgmt control channel and, whenever a managed controller
is powered with another address, has the kernel program ours again.

Controllers are identified by their device in sysfs rather than by address,
since the address is what changes. The factory address is whatever the
controller reports when it was not programmed by us; the daemon remembers it
to go back to.

    dms-bt-addr daemon                  run the service (root)
    dms-bt-addr status                  controllers and their state as JSON
    dms-bt-addr set DEVICE ADDRESS      use ADDRESS on the controller (root)
    dms-bt-addr reset DEVICE            go back to the factory address (root)

DEVICE is the controller's path under /sys/devices, as `status` reports it.
"""

import ctypes
import fcntl
import json
import os
import re
import select
import signal
import socket
import struct
import subprocess
import sys
import time

VERSION = "1.2.0"

CONFIG = "/etc/dms-bt-addr.conf"
STATE = "/run/dms-bt-addr/state.json"
KNOWN = "/var/lib/dms-bt-addr/known.json"
SERVICE = "dms-bt-addr.service"
INSTALL_PATHS = ["/usr/local/libexec/dms-bt-addr", "/usr/libexec/dms-bt-addr"]

HCI_DEV_NONE = 0xFFFF
HCI_CHANNEL_CONTROL = 3
HCIDEVDOWN = 0x400448CA  # _IOW('H', 202, int)

OP_READ_INDEX_LIST = 0x0003
OP_READ_INFO = 0x0004
OP_SET_POWERED = 0x0005
OP_READ_CONFIG_INFO = 0x0037
OP_SET_PUBLIC_ADDRESS = 0x0039

EV_CMD_COMPLETE = 0x0001
EV_CMD_STATUS = 0x0002
EV_INDEX_ADDED = 0x0004
EV_INDEX_REMOVED = 0x0005
EV_NEW_SETTINGS = 0x0006

SETTING_POWERED = 1 << 0
OPTION_PUBLIC_ADDRESS = 1 << 1

# Bluetooth SIG company identifiers of common controller vendors
MANUFACTURERS = {
    2: "Intel",
    10: "Qualcomm",
    13: "Texas Instruments",
    15: "Broadcom",
    29: "Qualcomm",
    70: "MediaTek",
    93: "Realtek",
    305: "Cypress",
}

# A controller that keeps losing the address is left alone rather than being
# power-cycled forever: after this many failed attempts in a row, or this many
# attempts within the window, it is marked failed until the config changes.
MAX_FAILURES = 3
MAX_ATTEMPTS = 10
ATTEMPT_WINDOW = 60

ADDRESS_RE = re.compile(r"^[0-9A-F]{2}(:[0-9A-F]{2}){5}$")


def log(message):
    print(message, file=sys.stderr)


def normalize(address):
    address = address.strip().upper().replace("-", ":")
    if not ADDRESS_RE.match(address) or address in ("00:00:00:00:00:00", "FF:FF:FF:FF:FF:FF"):
        raise ValueError(f"not a valid Bluetooth address: {address}")
    return address


def unpack_address(data):
    return ":".join(f"{b:02X}" for b in reversed(data[:6]))


def pack_address(address):
    return bytes(int(part, 16) for part in reversed(address.split(":")))


class MgmtError(Exception):
    def __init__(self, op, status):
        super().__init__(f"mgmt command {op:#06x} failed with status {status:#04x}")
        self.status = status


class Mgmt:
    """The kernel's Bluetooth management interface (doc/mgmt-api.txt in BlueZ).

    Sockets opened without CAP_NET_ADMIN are untrusted and can only read, which
    is all `status` needs.
    """

    def __init__(self):
        self.sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW | socket.SOCK_CLOEXEC, socket.BTPROTO_HCI)
        # socket.bind() cannot pick an HCI channel, so bind through libc
        addr = struct.pack("<HHH", socket.AF_BLUETOOTH, HCI_DEV_NONE, HCI_CHANNEL_CONTROL)
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.bind(self.sock.fileno(), addr, len(addr)) != 0:
            err = ctypes.get_errno()
            raise OSError(err, os.strerror(err))
        # Events that arrived while waiting for something else, for the main loop
        self.events = []

    def fileno(self):
        return self.sock.fileno()

    def receive(self, timeout):
        if not select.select([self.sock], [], [], timeout)[0]:
            return None
        data = self.sock.recv(65536)
        code, index, length = struct.unpack_from("<HHH", data)
        return code, index, data[6:6 + length]

    def command(self, op, index, params=b"", timeout=5):
        self.sock.send(struct.pack("<HHH", op, index, len(params)) + params)
        deadline = time.monotonic() + timeout
        while True:
            event = self.receive(max(0, deadline - time.monotonic()))
            if event is None:
                raise TimeoutError(f"mgmt command {op:#06x} timed out")
            code, event_index, params_ = event
            if code in (EV_CMD_COMPLETE, EV_CMD_STATUS) and event_index == index and struct.unpack_from("<H", params_)[0] == op:
                if params_[2]:
                    raise MgmtError(op, params_[2])
                return params_[3:]
            self.events.append(event)

    def wait_for(self, code, index, timeout):
        deadline = time.monotonic() + timeout
        while True:
            event = self.receive(max(0, deadline - time.monotonic()))
            if event is None:
                return False
            if event[0] == code and event[1] == index:
                return True
            self.events.append(event)

    def indexes(self):
        reply = self.command(OP_READ_INDEX_LIST, HCI_DEV_NONE)
        count = struct.unpack_from("<H", reply)[0]
        return list(struct.unpack_from(f"<{count}H", reply, 2))

    def info(self, index):
        reply = self.command(OP_READ_INFO, index)
        _version, manufacturer, _supported, current = struct.unpack_from("<BHII", reply, 6)
        name = reply[20:269].split(b"\0", 1)[0].decode(errors="replace")
        return {
            "index": index,
            "address": unpack_address(reply),
            "name": name,
            "manufacturer": MANUFACTURERS.get(manufacturer, f"#{manufacturer}"),
            "powered": bool(current & SETTING_POWERED),
        }

    def can_set_address(self, index):
        reply = self.command(OP_READ_CONFIG_INFO, index)
        _manufacturer, supported, _missing = struct.unpack_from("<HII", reply)
        return bool(supported & OPTION_PUBLIC_ADDRESS)


def device_of(index):
    """The controller's path under /sys/devices, stable across hciN numbering."""
    path = os.path.realpath(f"/sys/class/bluetooth/hci{index}/device")
    if not path.startswith("/sys/devices/"):
        return None
    return path[len("/sys/devices/"):]


def read_config():
    """DEVICE = ADDRESS lines, one per controller."""
    config = {}
    try:
        with open(CONFIG) as f:
            for number, line in enumerate(f, 1):
                line = line.split("#", 1)[0].strip()
                if not line:
                    continue
                device, _, address = (part.strip() for part in line.rpartition("="))
                try:
                    if "/" not in device:
                        raise ValueError(f"not a device path: {device}")
                    config[device] = normalize(address)
                except ValueError as e:
                    log(f"{CONFIG}:{number}: ignored: {e}")
    except FileNotFoundError:
        pass
    return config


def write_config(config):
    lines = ["# Managed by dms-bt-addr: controller under /sys/devices = address to use\n"]
    lines += [f"{device} = {address}\n" for device, address in sorted(config.items())]
    write_file(CONFIG, "".join(lines))


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_file(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


class Daemon:
    def __init__(self):
        self.mgmt = Mgmt()
        self.config = {}
        # Per device: the factory address, and every address we have set,
        # which can't be mistaken for the factory one later
        known = read_json(KNOWN)
        self.factory = known.get("factory", {})
        self.assigned = known.get("assigned", {})
        # Address each device had in the config before it was removed from it,
        # to put the factory address back
        self.restore = {}
        # Last address handed to the kernel per controller, since it ignores
        # an address equal to the one it already has
        self.programmed = {}
        self.attempts = {}
        self.failures = {}
        self.failed = {}
        self.hangup = False
        self.stop = False

    def reload(self):
        config = read_config()
        for device, address in self.config.items():
            if config.get(device) != address:
                self.restore[device] = address
        for device in config:
            self.restore.pop(device, None)
        self.config = config
        self.attempts.clear()
        self.failures.clear()
        self.failed.clear()
        self.save_state()
        log(f"config: {config or 'no controllers'}")
        for index in self.mgmt.indexes():
            self.evaluate(index)

    def save_state(self):
        write_file(STATE, json.dumps({"version": VERSION, "pid": os.getpid(), "failed": self.failed}))

    def save_known(self):
        write_file(KNOWN, json.dumps({"factory": self.factory, "assigned": self.assigned}))

    def learn(self, device, index, address):
        """An address the controller reports that we never set comes from its
        firmware, so it is the factory one."""
        if self.factory.get(device) == address or address in self.assigned.get(device, []):
            return
        if address in (self.config.get(device), self.programmed.get(index)):
            return
        log(f"hci{index}: factory address {address}")
        self.factory[device] = address
        self.save_known()

    def evaluate(self, index):
        device = device_of(index)
        if device is None:
            return
        try:
            info = self.mgmt.info(index)
        except (OSError, MgmtError):
            return  # the controller went away
        current = info["address"]
        self.learn(device, index, current)
        target = self.config.get(device)
        if target is None:
            if self.restore.get(device) != current or device not in self.factory:
                return
            target = self.factory[device]
        # Only a powered controller keeps the address: an unpowered one gets
        # its firmware, and with it the factory address, reloaded on power-on
        if not info["powered"] or current == target or device in self.failed:
            return
        now = time.monotonic()
        recent = [t for t in self.attempts.get(device, []) if now - t < ATTEMPT_WINDOW] + [now]
        self.attempts[device] = recent
        if len(recent) > MAX_ATTEMPTS:
            self.fail(device, f"the address was lost {MAX_ATTEMPTS} times in {ATTEMPT_WINDOW} s")
            return
        log(f"hci{index}: {current} -> {target}")
        if target != self.factory.get(device):
            assigned = [a for a in self.assigned.get(device, []) if a != target] + [target]
            if assigned != self.assigned.get(device):
                self.assigned[device] = assigned
                self.save_known()
        try:
            self.apply(index, current, target)
            info = self.mgmt.info(index)
            if info["address"] != target:
                raise RuntimeError(f"the controller still reports {info['address']}")
        except (OSError, MgmtError, RuntimeError) as e:
            log(f"hci{index}: {e}")
            self.failures[device] = self.failures.get(device, 0) + 1
            if self.failures[device] >= MAX_FAILURES:
                self.fail(device, str(e))
            self.power_on(index)
            return
        self.failures.pop(device, None)
        if device not in self.config:
            del self.restore[device]
        log(f"hci{index}: now {target}")

    def apply(self, index, current, target):
        # The kernel only programs an address that differs from the last one
        # it was given, so go through the current one first when needed
        if self.programmed.get(index) == target:
            self.program(index, current)
        if not self.program(index, target):
            # The kernel already had this address from before we started
            self.program(index, current)
            self.program(index, target)
        self.power_on(index)

    def program(self, index, address):
        """Have the kernel write the address to the controller; False if it
        already had it and did nothing."""
        # A controller left up in auto-off mode counts as unpowered for mgmt,
        # so Set Public Address is accepted, but the kernel then fails to
        # reopen it and the controller never comes back. Close it for real.
        with socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW | socket.SOCK_CLOEXEC, socket.BTPROTO_HCI) as raw:
            fcntl.ioctl(raw.fileno(), HCIDEVDOWN, index)
        self.mgmt.command(OP_SET_PUBLIC_ADDRESS, index, pack_address(address))
        self.programmed[index] = address
        # Programming takes the controller away and brings it back up in
        # auto-off mode, briefly enough for power_on() to keep it up as is
        if not self.mgmt.wait_for(EV_INDEX_REMOVED, index, 1.5):
            return False
        if not self.mgmt.wait_for(EV_INDEX_ADDED, index, 15):
            raise RuntimeError("the controller did not come back after programming the address")
        return True

    def power_on(self, index):
        try:
            self.mgmt.command(OP_SET_POWERED, index, b"\x01", timeout=10)
        except (OSError, MgmtError) as e:
            log(f"hci{index}: power on: {e}")

    def fail(self, device, reason):
        log(f"{device}: giving up until the config changes: {reason}")
        self.failed[device] = reason
        self.save_state()

    def handle(self, event):
        code, index, _params = event
        if code == EV_INDEX_REMOVED:
            self.programmed.pop(index, None)
        elif code in (EV_INDEX_ADDED, EV_NEW_SETTINGS):
            self.evaluate(index)

    def run(self):
        wake_r, wake_w = os.pipe2(os.O_NONBLOCK | os.O_CLOEXEC)
        signal.set_wakeup_fd(wake_w)
        signal.signal(signal.SIGHUP, lambda *_: setattr(self, "hangup", True))
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "stop", True))
        signal.signal(signal.SIGINT, lambda *_: setattr(self, "stop", True))
        self.reload()
        while not self.stop:
            if self.hangup:
                self.hangup = False
                self.reload()
                continue
            if self.mgmt.events:
                self.handle(self.mgmt.events.pop(0))
                continue
            ready = select.select([self.mgmt, wake_r], [], [])[0]
            if wake_r in ready:
                os.read(wake_r, 64)
            if self.mgmt in ready:
                event = self.mgmt.receive(0)
                if event:
                    self.handle(event)


def installed_version():
    for path in INSTALL_PATHS:
        try:
            with open(path) as f:
                match = re.search(r'^VERSION = "([^"]+)"', f.read(), re.M)
            return {"path": path, "version": match.group(1) if match else None}
        except OSError:
            continue
    return None


def service_state():
    try:
        with open(STATE) as f:
            state = json.load(f)
        os.kill(state["pid"], 0)
    except PermissionError:
        return state  # alive, just not ours to signal
    except (OSError, ValueError, KeyError):
        return None
    return state


def status():
    config = read_config()
    known = read_json(KNOWN)
    factory = known.get("factory", {})
    assigned = known.get("assigned", {})
    service = service_state()
    failed = service["failed"] if service else {}
    controllers = []
    error = None
    try:
        mgmt = Mgmt()
        for index in mgmt.indexes():
            try:
                info = mgmt.info(index)
                info["device"] = device_of(index)
                info["canSetAddress"] = info["device"] is not None and mgmt.can_set_address(index)
            except MgmtError:
                continue
            target = config.get(info["device"])
            info["target"] = target
            info["lastAddress"] = (assigned.get(info["device"]) or [None])[-1]
            # Without the service's record, an unmanaged controller most
            # likely still has the address it came with
            info["factory"] = factory.get(info["device"]) or (info["address"] if target is None else None)
            if target is None:
                info["state"] = "unmanaged"
            elif info["device"] in failed:
                info["state"] = "failed"
                info["error"] = failed[info["device"]]
            elif info["address"] == target:
                info["state"] = "applied"
            else:
                info["state"] = "pending"
            controllers.append(info)
    except OSError as e:
        error = str(e)
    json.dump({
        "version": VERSION,
        "installed": installed_version(),
        "running": service is not None,
        "controllers": controllers,
        "error": error,
    }, sys.stdout)
    print()


def reload_service():
    if subprocess.run(["systemctl", "reload", SERVICE], stderr=subprocess.DEVNULL).returncode != 0:
        sys.exit(f"saved to {CONFIG}, but {SERVICE} is not running")


def main(argv):
    if len(argv) > 1 and argv[1] in ("daemon", "set", "reset") and os.geteuid() != 0:
        sys.exit(f"{argv[1]} needs root")
    if len(argv) == 2 and argv[1] == "daemon":
        Daemon().run()
    elif len(argv) == 2 and argv[1] == "status":
        status()
    elif len(argv) == 4 and argv[1] == "set":
        device = argv[2]
        try:
            address = normalize(argv[3])
        except ValueError as e:
            sys.exit(str(e))
        if not os.path.isdir(os.path.join("/sys/devices", device, "bluetooth")):
            sys.exit(f"no Bluetooth controller at {device}")
        config = read_config()
        if any(other != device and used == address for other, used in config.items()):
            sys.exit(f"{address} is already used by another controller")
        config[device] = address
        write_config(config)
        reload_service()
    elif len(argv) == 3 and argv[1] == "reset":
        config = read_config()
        config.pop(argv[2], None)
        write_config(config)
        reload_service()
    elif len(argv) == 2 and argv[1] == "--version":
        print(VERSION)
    else:
        sys.exit(__doc__.split("\n\n", 2)[2].rstrip())


if __name__ == "__main__":
    main(sys.argv)
